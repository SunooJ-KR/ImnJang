# 비밀정보
.env

# 가상환경 (플랫폼 종속, 재생성 가능)
.venv/

# API 응답 캐시 (재생성 가능, 대용량)
output/cache_*.json
output/raw/
output/*.log

# 수집 결과 테이블 (대용량, 재생성 가능)
output/11.[12].trades_*.txt
output/12.[123].osm_*.txt
# 동 배정 상세는 12.1 + 14.1에서 결정적으로 재생성된다 (3.6MB)
# 14.1은 카카오 API 호출 8,400건의 산물이라 커밋한다
output/15.2.building_assigned.txt

