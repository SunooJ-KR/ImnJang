{
  "name": "imnjang-front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "node -e \"fs.rmSync('.next',{recursive:true,force:true});fs.rmSync('out',{recursive:true,force:true})\"",
    "build": "next build",
    "start": "serve out",
    "preview": "npm run build && serve out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && python ../front/build/37.check_wording.py",
    "payload": "python ../front/build/36.build_payload.py"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  }
}
