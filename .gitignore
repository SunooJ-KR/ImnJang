# 비밀정보
.env

# 가상환경 (플랫폼 종속, 재생성 가능)
.venv/

# API 응답 캐시 (재생성 가능, 대용량)
output/cache_*.json
output/raw/
output/*.log

# 수집 결과 테이블 (대용량, 재생성 가능)
output/11.[12].trades_*.txt
output/12.[123].osm_*.txt
# 동 배정 상세는 12.1 + 14.1에서 결정적으로 재생성된다 (3.6MB)
# 14.1은 카카오 API 호출 8,400건의 산물이라 커밋한다
output/15.2.building_assigned.txt
# 건축물대장 표제부 원본 (8.4MB). 로컬 캐시(output/raw/ledger/)로 즉시,
# 캐시가 없으면 API 호출 8,755건으로 재생성된다 (일 한도 10,000건 내)
output/19.1.building_ledger.txt
# horizon 관측점 원본 (3MB, 65,751행). 디버깅용이며 21을 90초 돌리면 재생성된다.
# 집계본 21.1.complex_metrics.txt 는 downstream 입력이므로 커밋한다
output/21.2.observation_points.txt
# OSM 도로(2.2MB)·공원(1MB) 원본. 24를 다시 돌리면 재생성된다 —
# output/raw/osm_extra/ 캐시가 있으면 20초, 없으면 Overpass 재수집 약 8분.
# 이들에서 파생된 26.1.transit_metrics.txt 가 downstream 입력이므로 그쪽을 커밋한다
output/24.1.osm_roads.txt
output/24.3.osm_parks.txt

# Python
__pycache__/
*.pyc

# 관측점별 72방위 스카이라인 (19MB). 21.horizon_batch.py로 90초에 재생성된다
output/21.3.skyline.npy

# 정적 payload (55.9MB, 9,160개 파일). front/build/36.build_payload.py 로 재생성된다.
# 재빌드마다 전량 변경되므로 개발 중에는 추적하지 않고, 배포 직전에 한 번만 커밋한다.
front/public/data/

# 카카오 JS 키가 들어가는 로컬 설정. config.example.js 를 복사해 쓴다
front/public/config.js
