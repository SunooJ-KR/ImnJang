# 저장소 루트의 .env 로 복사해 값을 채운다 (chmod 600 권장). 값은 절대 커밋하지 않는다.
# 스크립트는 os.environ 이 아니라 load_env("KEY") 로 .env 파일을 직접 파싱한다.
# 공공데이터포털 일반 인증키 (data.go.kr, 실거래·건축물대장·심평원)
DATA_GO_KR_KEY=
# 카카오 REST API 키 (지오코딩, developers.kakao.com)
KAKAO_REST_KEY=
# 카카오 JavaScript SDK 키 (프론트 지도, 도메인 제한 공개키)
NEXT_PUBLIC_KAKAO_JS_KEY=
# NEIS 교육정보 개방포털 인증키 (open.neis.go.kr, 학교 정보)
NEIS_KEY=
# 서울 열린데이터광장 인증키 (data.seoul.go.kr, 승하차·교통)
SEOUL_OPENAPI_KEY=
